{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k3.1-pro",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "openai/gpt6-2-terra#medium"
    },
    "plan": {
      "model": "openai/gpt6-2-sol#high"
    }
  },
  "mcp": {
    "servers": {
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-awsi-cli@latest",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--region", "us-east-2",
          "--metadata",
          "INSTALL_SOURCE=aws-cli"
        ],
        "environment": {
          "AWS_MCP_PROXY_PROFILES": "research"
        },
        "disabled": true
      }
    }
  },
  "plugins": ["/Users/bob/dotfiles/opencode/plugins/archive-arxiv"]
}
